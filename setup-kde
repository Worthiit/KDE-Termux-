#!/data/data/com.termux/files/usr/bin/bash

echo -e "\033[1;36m[+] Prepping Native KDE (No PRoot)...\033[0m"
pkg update -y
pkg install -y x11-repo
pkg install -y termux-x11-nightly pulseaudio dbus-launch \
    kde-plasma-desktop-core xterm p7zip wget 

curl -fsSL "https://raw.githubusercontent.com/YourRepo/NativeKDE/main/kde" -o $PREFIX/bin/kde
chmod +x $PREFIX/bin/kde

echo -e "\033[1;32m[✔] Install complete. Use 'kde' to launch.\033[0m"
